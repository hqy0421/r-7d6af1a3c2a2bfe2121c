# ---------------------------------------------------------------------------
# PulseWatch — example environment. Copy to backend/.env and adjust.
# The web app reads frontend/.env.local (see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
APP_URL=http://localhost:3000    # the web app, used for CORS
PUBLIC_API_URL=http://localhost:8000

# --- Database ----------------------------------------------------------------
# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pulsewatch
DATABASE_URL=sqlite:///./pulsewatch.db

# --- Security ----------------------------------------------------------------
# Signs sessions and derives the key that encrypts notification credentials.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- Monitoring engine --------------------------------------------------------
# Whether this process runs the scheduler. Run exactly one instance with
# SCHEDULER_ENABLED=true; see "Known production limitations" in the README.
SCHEDULER_ENABLED=true
# How often the scheduler looks for monitors that are due, in seconds.
SCHEDULER_TICK_SECONDS=1
# Upper bound on checks running at the same time across all monitors.
MAX_CONCURRENT_CHECKS=20
# Hard ceiling on a single check, regardless of a monitor's own timeout.
MAX_CHECK_TIMEOUT_SECONDS=30
# Consecutive failures before an incident opens (per monitor default).
DEFAULT_FAILURE_THRESHOLD=3
# A successful check slower than this is reported as degraded.
DEFAULT_DEGRADED_MS=1500
# Checks older than this are pruned by `python -m app.cli prune-checks`.
CHECK_RETENTION_DAYS=30

# --- Outbound safety ----------------------------------------------------------
# Monitors and notifications may not target private or loopback addresses
# unless this is true. It is the SSRF guard: keep it false outside development.
# The bundled /demo endpoints are exempt, so demos work with the guard on.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# --- Notifications ------------------------------------------------------------
# In dry-run mode alerts are rendered and recorded but never sent. Useful for
# demos and for the test suite; turn it off to deliver real notifications.
NOTIFICATIONS_DRY_RUN=false
